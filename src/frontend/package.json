{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "scripts/generate-env.js && vite build",
    "clean": "rm -rf dist",
    "lint": "npm run clean && eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc --noEmit",
    "start": "vite --open",
    "test": "vitest",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@atlaskit/button": "25.0.4",
    "@atlaskit/code": "19.0.0",
