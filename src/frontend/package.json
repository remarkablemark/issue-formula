{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-env.mjs && vite build",
    "clean": "rm -rf dist",
    "lint": "npm run clean && eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc",
    "start": "vite --open",
    "test": "vitest run",
    "test:ci": "CI=true npm test -- --color --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@atlaskit/button": "25.6.1",
    "@atlaskit/code": "19.1.0",
    "@atlaskit/css-reset": "8.4.0",
    "@atlaskit/form": "18.3.1",
    "@atlaskit/heading": "7.2.0",
    "@atlaskit/icon": "37.3.0",
    "@atlaskit/primitives": "22.4.0",
    "@atlaskit/select": "23.1.5",
    "@atlaskit/spinner": "20.4.4",
    "@atlaskit/textarea": "10.0.0",
    "@atlaskit/textfield": "10.3.0",
    "@atlaskit/tokens": "20.8.2",
    "@forge/bridge": "7.2.1",
    "expr-eval": "2.0.2",
    "react": "18",
    "react-dom": "18",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
