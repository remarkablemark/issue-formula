{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-env.mjs && vite build",
    "clean": "rm -rf dist",
    "lint": "npm run clean && eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:tsc": "tsc",
    "start": "vite --open",
    "test": "vitest run",
    "test:ci": "CI=true npm test -- --color --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@atlaskit/button": "25.7.0",
    "@atlaskit/code": "20.0.0",
    "@atlaskit/css-reset": "8.4.10",
    "@atlaskit/form": "18.3.1",
    "@atlaskit/heading": "8.0.0",
    "@atlaskit/icon": "38.0.2",
    "@atlaskit/primitives": "22.6.0",
    "@atlaskit/select": "23.1.5",
    "@atlaskit/spinner": "20.4.4",
    "@atlaskit/textarea": "10.3.0",
    "@atlaskit/textfield": "10.3.0",
    "@atlaskit/tokens": "20.9.0",
    "@forge/bridge": "7.2.1",
    "expr-eval": "2.0.2",
    "react": "18",
    "react-dom": "18",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
