    "@atlaskit/heading": "5.4.2",
    "@atlaskit/icon": "37.3.0",
    "@atlaskit/primitives": "22.2.2",
    "@atlaskit/select": "22.0.0",
    "@atlaskit/spinner": "20.1.2",
    "@atlaskit/textarea": "10.0.0",
    "@atlaskit/textfield": "10.0.1",
    "@atlaskit/tokens": "14.0.0",
    "@forge/bridge": "6.2.0",
    "expr-eval": "2.0.2",
    "react": "19",
    "react-dom": "19",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
